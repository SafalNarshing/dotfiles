#!/usr/bin/env python3
"""weather — current conditions in the same style as fastfetch.

    weather                 current location (geolocated from IP)
    weather London          named location
    weather "New York"      multi-word names need quoting
    weather -f [place]      add a three-day forecast
    weather -l [place]      one line, for status bars and scripts

Data comes from wttr.in, which needs no API key. Responses are cached for ten
minutes in the runtime dir: wttr.in rate-limits per IP, and without a cache a
status bar polling every few minutes would start getting refused.
"""

import json
import os
import sys
import time
import urllib.request
import urllib.error
import urllib.parse
from datetime import datetime

# Palette lifted from the fastfetch config so the two read as one tool.
KEY = "\033[38;2;150;152;170m"
VAL = "\033[38;2;206;208;222m"
ICON = "\033[38;2;176;178;196m"
RULE = "\033[38;2;100;102;118m"
DIM = "\033[38;2;120;122;138m"
OFF = "\033[0m"

CACHE_TTL = 600  # seconds

# World Weather Online condition codes -> Nerd Font glyphs.
# Grouped rather than enumerated: the code list is long and mostly variations
# of intensity that map to the same icon.
ICONS = {
    "clear_day": "󰖙", "clear_night": "󰖔", "partly": "󰖕", "cloudy": "󰖐",
    "overcast": "󰅟", "fog": "󰖑", "drizzle": "󰖗", "rain": "󰖗",
    "heavy_rain": "󰖖", "snow": "󰖘", "sleet": "󰙿", "thunder": "󰖓",
}

CODE_MAP = {
    113: "clear", 116: "partly", 119: "cloudy", 122: "overcast",
    143: "fog", 248: "fog", 260: "fog",
    176: "drizzle", 263: "drizzle", 266: "drizzle", 281: "drizzle", 284: "drizzle",
    293: "rain", 296: "rain", 299: "rain", 302: "rain", 353: "rain", 356: "rain",
    305: "heavy_rain", 308: "heavy_rain", 359: "heavy_rain",
    311: "sleet", 314: "sleet", 317: "sleet", 320: "sleet", 362: "sleet",
    365: "sleet", 182: "sleet", 185: "sleet",
    179: "snow", 227: "snow", 230: "snow", 323: "snow", 326: "snow",
    329: "snow", 332: "snow", 335: "snow", 338: "snow", 350: "snow",
    368: "snow", 371: "snow", 374: "snow", 377: "snow",
    200: "thunder", 386: "thunder", 389: "thunder", 392: "thunder", 395: "thunder",
}


def icon_for(code, hour=None):
    kind = CODE_MAP.get(int(code), "cloudy")
    if kind == "clear":
        night = hour is not None and (hour < 6 or hour >= 19)
        kind = "clear_night" if night else "clear_day"
    return ICONS.get(kind, "󰖐")


def fetch(location):
    slug = urllib.parse.quote(location) if location else ""
    cache = os.path.join(
        os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
        "weather-%s.json" % (slug.replace("/", "_") or "here"),
    )

    if os.path.exists(cache) and time.time() - os.path.getmtime(cache) < CACHE_TTL:
        with open(cache, encoding="utf-8") as fh:
            return json.load(fh)

    url = "https://wttr.in/%s?format=j1" % slug
    req = urllib.request.Request(url, headers={"User-Agent": "curl/8"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        # wttr.in answers an unresolvable place with 500, not 404, so a plain
        # "HTTP 500" would send you chasing a server fault that is really a typo.
        if exc.code in (404, 500) and location:
            die("Could not find location: %s" % location)
        die("wttr.in returned HTTP %s" % exc.code)
    except (urllib.error.URLError, TimeoutError):
        # Stale cache beats nothing when the network is down.
        if os.path.exists(cache):
            with open(cache, encoding="utf-8") as fh:
                return json.load(fh)
        die("Could not reach wttr.in — check your connection.")
    except json.JSONDecodeError:
        die("wttr.in sent something that was not JSON (rate limited?).")

    try:
        with open(cache, "w", encoding="utf-8") as fh:
            json.dump(data, fh)
    except OSError:
        pass
    return data


def die(msg):
    print("%s%s%s" % (KEY, msg, OFF), file=sys.stderr)
    sys.exit(1)


def place_name(data):
    area = (data.get("nearest_area") or [{}])[0]

    def first(key):
        vals = area.get(key) or [{}]
        return (vals[0] or {}).get("value", "")

    bits = [first("areaName"), first("region"), first("country")]
    bits = [b for b in bits if b]
    # Region is often just the areaName repeated; drop the duplicate.
    if len(bits) > 2 and bits[0] == bits[1]:
        bits.pop(1)
    return ", ".join(bits) if bits else "Unknown location"


def row(label, value):
    print("   %s%-11s%s %s%s%s" % (KEY, label, OFF, VAL, value, OFF))


def main():
    args = sys.argv[1:]
    mode = "full"

    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    if args and args[0] in ("-f", "--forecast"):
        mode, args = "forecast", args[1:]
    elif args and args[0] in ("-l", "--line"):
        mode, args = "line", args[1:]

    location = " ".join(args).strip()
    data = fetch(location)

    cur = (data.get("current_condition") or [{}])[0]
    desc = (cur.get("weatherDesc") or [{}])[0].get("value", "?").strip()
    code = cur.get("weatherCode", "119")
    hour = datetime.now().hour
    glyph = icon_for(code, hour)

    if mode == "line":
        print("%s %s°C  %s" % (glyph, cur.get("temp_C", "?"), desc))
        return

    name = place_name(data)
    rule = "─" * 34

    print()
    print("   %s%s%s  %s%s%s" % (ICON, glyph, OFF, VAL, name, OFF))
    print("   %s%s%s" % (RULE, rule, OFF))
    row("condition", desc)
    row("temp", "%s°C   %sfeels %s°C%s"
        % (cur.get("temp_C", "?"), DIM, cur.get("FeelsLikeC", "?"), OFF))
    row("humidity", "%s%%" % cur.get("humidity", "?"))
    row("wind", "%s km/h %s" % (cur.get("windspeedKmph", "?"),
                                cur.get("winddir16Point", "")))
    row("pressure", "%s hPa" % cur.get("pressure", "?"))
    row("visibility", "%s km" % cur.get("visibility", "?"))
    row("uv index", cur.get("uvIndex", "?"))

    if mode == "forecast":
        print("   %s%s%s" % (RULE, rule, OFF))
        for i, day in enumerate((data.get("weather") or [])[:3]):
            when = ["today", "tomorrow", "day after"][i] if i < 3 else day.get("date")
            noon = (day.get("hourly") or [{}])[4] if len(day.get("hourly") or []) > 4 else {}
            g = icon_for(noon.get("weatherCode", code), 12)
            row(when, "%s  %s–%s°C   %srain %s%%%s"
                % (g, day.get("mintempC", "?"), day.get("maxtempC", "?"),
                   DIM, noon.get("chanceofrain", "0"), OFF))
    print()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
