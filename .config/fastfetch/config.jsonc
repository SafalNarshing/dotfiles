// fastfetch — Spider-Man chest emblem, greyscale palette.
// Replaces the default Arch logo and its blue accent.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        // Absolute path: fastfetch does not expand ~ in this field.
        "type": "file",
        "source": "/home/spidey/.config/fastfetch/spider.txt",
        // $1 in the art maps to this. Cool light grey, tinted very slightly
        // toward the violet used across waybar and the Hyprland borders.
        "color": {
            "1": "38;2;176;178;196"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },

    "display": {
        "color": {
            "keys": "38;2;150;152;170",
            "title": "38;2;206;208;222"
        },
        "separator": "  ",
        "key": {
            "width": 11
        }
    },

    "modules": [
        "break",
        {
            "type": "title",
            "color": {
                "user": "38;2;206;208;222",
                "at": "38;2;120;122;138",
                "host": "38;2;176;178;196"
            }
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;100;102;118m──────────────────────────────"
        },
        { "type": "os",       "key": "os" },
        { "type": "kernel",   "key": "kernel" },
        { "type": "uptime",   "key": "uptime" },
        { "type": "packages", "key": "packages" },
        { "type": "shell",    "key": "shell" },
        { "type": "wm",       "key": "wm" },
        { "type": "terminal", "key": "term" },
        {
            "type": "custom",
            "format": "\u001b[38;2;100;102;118m──────────────────────────────"
        },
        { "type": "cpu",     "key": "cpu",  "showPeCoreCount": true },
        { "type": "gpu",     "key": "gpu" },
        { "type": "memory",  "key": "memory" },
        { "type": "disk",    "key": "disk", "folders": "/" },
        { "type": "display", "key": "screen" },
        { "type": "battery", "key": "battery" },
        {
            "type": "custom",
            "format": "\u001b[38;2;100;102;118m──────────────────────────────"
        },
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}
